# WhatsApp recipient with international prefix and without the leading +.
ALFRED_WHATSAPP_RECIPIENT=39xxxxxxxxxx

# TomTom API key with access to Search and Routing APIs.
ALFRED_TOMTOM_API_KEY=replace-with-your-api-key

# Google Calendar OAuth files. By default Alfred reads google-oauth-client.json and
# google-calendar-token.json from ALFRED_CONFIG_DIR (default: ~/.claude/config), falling back
# to the repository's credentials/ folder. Uncomment only to use other locations.
# ALFRED_CONFIG_DIR=~/.claude/config
# ALFRED_GOOGLE_CALENDAR_CLIENT_SECRET_FILE=~/.claude/config/google-oauth-client.json
# ALFRED_GOOGLE_CALENDAR_TOKEN_FILE=~/.claude/config/google-calendar-token.json
